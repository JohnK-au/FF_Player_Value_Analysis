# Copy this file to ".env" and fill in the real values.
# ".env" is git-ignored, so your league's identifiers never get committed to
# this public repository.
#
# For Option A (unauthenticated CSV export) the contract Google Sheet must be
# shared as "Anyone with the link can view".

# The spreadsheet ID — the long string between "/d/" and "/edit" in the sheet URL.
CONTRACTS_SHEET_ID=your_spreadsheet_id_here

# Default tab to read — the "gid=" value in the sheet URL (0 is the first tab).
CONTRACTS_DEFAULT_GID=0

# --- ESPN fantasy league (private league → requires your auth cookies) ---
# League/team IDs are in the league URL (leagueId=..., teamId=...).
ESPN_LEAGUE_ID=your_league_id_here
ESPN_TEAM_ID=your_team_id_here
# Season to read by default (e.g. last completed season with full data).
ESPN_SEASON=2025
# Auth cookies from a logged-in browser session (DevTools → Application → Cookies).
# These authenticate AS YOU — keep them only in .env, never commit them.
ESPN_S2=your_espn_s2_cookie_here
ESPN_SWID={your-swid-with-braces}
